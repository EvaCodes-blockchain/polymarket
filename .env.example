# ─── Ganache (local EVM node) ─────────────────────────────────────────────────
# Chain ID used by Ganache — MUST match Hardhat config and wagmi/viem client
NEXT_PUBLIC_CHAIN_ID=1337

# JSON-RPC URL used by the browser (wagmi/viem) and the backend (ethers/viem)
NEXT_PUBLIC_RPC_URL=http://localhost:8545

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Full Prisma connection URL (copy to web/.env.local for local dev)
DATABASE_URL=postgresql://justify:justify@localhost:5432/justify

# ─── NextAuth.js ──────────────────────────────────────────────────────────────
# Canonical URL of the app — used for OAuth redirect URIs and CSRF
NEXTAUTH_URL=http://localhost:3000

# Random secret — generate with: openssl rand -base64 32
# MUST be set in production
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# ─── Google OAuth (for NextAuth Google provider) ──────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
