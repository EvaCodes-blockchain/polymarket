# ─── Chain (env-driven: Ganache local | Circle Arc testnet) ───────────────────
# Defaults below target local Ganache. To target Arc testnet, set:
#   NEXT_PUBLIC_CHAIN_ID=5042002
#   NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network
#   NEXT_PUBLIC_CHAIN_NAME="Arc Testnet"
#   NEXT_PUBLIC_NATIVE_SYMBOL=USDC     # Arc pays gas in USDC (18 decimals)
#   RPC_URL=https://rpc.testnet.arc.network
#   COLLATERAL_USDC_ADDRESS=0x...      # Circle testnet USDC ERC-20 (6 decimals)
#
# Chain ID — MUST match Hardhat network + wagmi/viem client
NEXT_PUBLIC_CHAIN_ID=1337
# JSON-RPC URL used by the browser (wagmi/viem) and the backend (ethers/viem)
NEXT_PUBLIC_RPC_URL=http://localhost:8545
# Chain display name + native gas token symbol (Ganache/ETH by default)
NEXT_PUBLIC_CHAIN_NAME=Ganache
NEXT_PUBLIC_NATIVE_SYMBOL=ETH

# Server-side JSON-RPC (chain.ts / deploy). Same as NEXT_PUBLIC_RPC_URL outside
# docker; inside compose the web service uses http://ganache:8545.
RPC_URL=http://localhost:8545

# External collateral USDC token address. Leave EMPTY for local Ganache (our
# mintable MockUSDC). Set to the Circle testnet USDC address on Arc to use real
# USDC as collateral — this disables the in-app mint faucet.
COLLATERAL_USDC_ADDRESS=

# Public faucet shown to users when in-app minting is disabled (external USDC).
PUBLIC_FAUCET_URL=https://faucet.circle.com/

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Full Prisma connection URL (copy to web/.env.local for local dev)
DATABASE_URL=postgresql://justify:justify@localhost:5432/justify

# ─── NextAuth.js ──────────────────────────────────────────────────────────────
# Canonical URL of the app — used for OAuth redirect URIs and CSRF
NEXTAUTH_URL=http://localhost:3000

# Random secret — generate with: openssl rand -base64 32
# MUST be set in production
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# ─── Google OAuth (for NextAuth Google provider) ──────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
