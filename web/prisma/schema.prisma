// Prisma schema for PolyMarket Social ("Justify")
// Database: PostgreSQL (justify/justify@localhost:5432/justify via docker-compose)
//
// Integration contract — announce breaking changes to the orchestrator before merging.
// Models:
//   User, Account, Session, VerificationToken — standard NextAuth.js shapes (@auth/prisma-adapter)
//   Wallet                                    — CEO-3: bind a verified wallet address to a user
//   Follow                                    — CEO-2: social graph (follower/followee)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// NextAuth.js standard models (@auth/prisma-adapter v2)
// Ref: https://authjs.dev/getting-started/adapters/prisma
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // App-level relations
  wallets     Wallet[]
  following   Follow[] @relation("follower")
  followers   Follow[] @relation("followee")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Wallet — CEO-3: verified wallet address bound to a user
// One user can hold multiple wallet addresses (e.g. MetaMask + Coinbase).
// address is the checksummed EVM address (0x…, 42 chars).
// ---------------------------------------------------------------------------

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  address   String   @unique // checksummed EVM address, globally unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

// ---------------------------------------------------------------------------
// Follow — CEO-2: social graph
// Unique composite prevents duplicate follows.
// ---------------------------------------------------------------------------

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  follower User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@map("follows")
}
