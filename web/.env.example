# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string — matches docker-compose.yaml postgres service
DATABASE_URL="postgresql://justify:justify@localhost:5432/justify"

# ── NextAuth.js ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
# Full URL of the Next.js app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (optional — only needed if enabling Google sign-in) ──────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ── Chain (env-driven: Ganache local | Circle Arc testnet) ──────────────────
# For Arc testnet: CHAIN_ID=5042002, RPC=https://rpc.testnet.arc.network,
# CHAIN_NAME="Arc Testnet", NATIVE_SYMBOL=USDC (Arc gas token is USDC, 18 dec).
NEXT_PUBLIC_CHAIN_ID=1337
NEXT_PUBLIC_RPC_URL="http://localhost:8545"
NEXT_PUBLIC_CHAIN_NAME="Ganache"
NEXT_PUBLIC_NATIVE_SYMBOL="ETH"

# ── Server-side chain access (web/src/lib/server/chain.ts) ───────────────────
# JSON-RPC endpoint used by API routes for market creation / faucet / prices.
# Inside docker compose this becomes http://ganache:8545. For Arc set it to
# https://rpc.testnet.arc.network.
RPC_URL="http://localhost:8545"
# External collateral USDC ERC-20 (Circle USDC on Arc, 6 decimals). EMPTY = use
# our mintable MockUSDC (local). When set, the in-app /api/faucet mint is off.
COLLATERAL_USDC_ADDRESS=""
# Public faucet link surfaced when in-app minting is disabled (external USDC).
PUBLIC_FAUCET_URL="https://faucet.circle.com/"
# Same deterministic mnemonic as the compose ganache service (account mapping:
# 0 deployer/admin, 1 oracle, 2-5 traders, 6 market creator, 7-9 generator bots).
# Ganache test mnemonic only — NEVER a real wallet seed.
GANACHE_MNEMONIC="justify social prediction market mvp test test test test test test junk"
# Optional override for the contracts deployment artifact path; defaults to
# ../contracts/deployments/ganache.json relative to the web workspace.
# DEPLOYMENTS_FILE=""

# ── Market generator (test/demo component) ────────────────────────────────────
# Shared secret accepted in the x-generator-key header by POST /api/markets,
# /api/posts and /api/faucet (web/src/lib/server/generatorAuth.ts).
# Dev default only — set a real value in any shared environment.
GENERATOR_API_KEY="dev-generator-key"
# Target environment for the generator and integration tests. Validated against
# the generator's hostname allowlist (localhost, 127.0.0.1, *.test, *.staging,
# plus EXTRA_ALLOWED_HOSTS); compose sets http://web:3000 + EXTRA_ALLOWED_HOSTS=web.
API_BASE_URL="http://localhost:3000"
# Generator-only knobs (full table in testing-market-generator.md Section 7;
# compose provides safe defaults): NEWS_SOURCE=fixture|live, NEWS_TOPICS,
# POLL_INTERVAL, MARKETS_PER_HOUR, MAX_LIVE_MARKETS, CLOSE_WINDOW,
# GENERATOR_TRADING=on|off, RESOLVE_YES_BIAS, GENERATOR_SEED.
